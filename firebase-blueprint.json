{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated FoodSnap user profile metadata without sensitive PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name for the user.",
          "minLength": 1,
          "maxLength": 120
        },
        "photoUrl": {
          "type": "string",
          "description": "Profile avatar URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        }
      },
      "required": ["uid", "displayName", "createdAt"]
    },
    "FoodScan": {
      "title": "FoodScan",
      "description": "AI-analyzed food scan with ingredients, description, nutrition estimates, and compressed image thumbnail.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique scan identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "foodName": {
          "type": "string",
          "description": "Identified dish or food name.",
          "minLength": 1,
          "maxLength": 140
        },
        "cuisineOrCategory": {
          "type": "string",
          "description": "Short cuisine or meal category.",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Concise AI description of the identified dish.",
          "minLength": 1,
          "maxLength": 800
        },
        "servingSize": {
          "type": "string",
          "description": "Estimated portion or serving size.",
          "minLength": 1,
          "maxLength": 80
        },
        "calories": {
          "type": "number",
          "description": "Estimated kilocalories for the pictured serving."
        },
        "proteinGrams": {
          "type": "number",
          "description": "Estimated protein in grams."
        },
        "carbsGrams": {
          "type": "number",
          "description": "Estimated carbohydrates in grams."
        },
        "fatGrams": {
          "type": "number",
          "description": "Estimated fat in grams."
        },
        "fiberGrams": {
          "type": "number",
          "description": "Estimated dietary fiber in grams."
        },
        "ingredients": {
          "type": "array",
          "description": "Possible detected ingredients (1 to 25 items)."
        },
        "healthHighlights": {
          "type": "array",
          "description": "Short nutritional highlights (up to 8 items)."
        },
        "thumbnailDataUrl": {
          "type": "string",
          "description": "Compressed JPEG data URL thumbnail of the scanned dish.",
          "maxLength": 180000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the scan."
        }
      },
      "required": [
        "id",
        "userId",
        "foodName",
        "cuisineOrCategory",
        "description",
        "servingSize",
        "calories",
        "proteinGrams",
        "carbsGrams",
        "fatGrams",
        "fiberGrams",
        "ingredients",
        "healthHighlights",
        "thumbnailDataUrl",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile document."
    },
    "/foodScans/{scanId}": {
      "schema": { "$ref": "#/entities/FoodScan" },
      "description": "Owner-scoped food scan history records."
    }
  }
}
