rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    function isValidFoodScan(data, scanId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'foodName',
          'cuisineOrCategory',
          'description',
          'servingSize',
          'calories',
          'proteinGrams',
          'carbsGrams',
          'fatGrams',
          'fiberGrams',
          'ingredients',
          'healthHighlights',
          'thumbnailDataUrl',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'userId',
          'foodName',
          'cuisineOrCategory',
          'description',
          'servingSize',
          'calories',
          'proteinGrams',
          'carbsGrams',
          'fatGrams',
          'fiberGrams',
          'ingredients',
          'healthHighlights',
          'thumbnailDataUrl',
          'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.id == scanId &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.foodName is string &&
        data.foodName.size() >= 1 &&
        data.foodName.size() <= 140 &&
        data.cuisineOrCategory is string &&
        data.cuisineOrCategory.size() >= 1 &&
        data.cuisineOrCategory.size() <= 80 &&
        data.description is string &&
        data.description.size() >= 1 &&
        data.description.size() <= 800 &&
        data.servingSize is string &&
        data.servingSize.size() >= 1 &&
        data.servingSize.size() <= 80 &&
        data.calories is number &&
        data.calories >= 0 &&
        data.calories <= 10000 &&
        data.proteinGrams is number &&
        data.proteinGrams >= 0 &&
        data.proteinGrams <= 1000 &&
        data.carbsGrams is number &&
        data.carbsGrams >= 0 &&
        data.carbsGrams <= 1000 &&
        data.fatGrams is number &&
        data.fatGrams >= 0 &&
        data.fatGrams <= 1000 &&
        data.fiberGrams is number &&
        data.fiberGrams >= 0 &&
        data.fiberGrams <= 500 &&
        data.ingredients is list &&
        data.ingredients.size() >= 1 &&
        data.ingredients.size() <= 25 &&
        data.ingredients[0] is string &&
        data.ingredients[0].size() <= 80 &&
        data.healthHighlights is list &&
        data.healthHighlights.size() <= 8 &&
        (data.healthHighlights.size() == 0 || (data.healthHighlights[0] is string && data.healthHighlights[0].size() <= 160)) &&
        data.thumbnailDataUrl is string &&
        data.thumbnailDataUrl.size() <= 180000 &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl']);
      allow delete: if false;
    }

    match /foodScans/{scanId} {
      allow get: if isSignedIn() && isValidId(scanId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(scanId) &&
        isValidFoodScan(incoming(), scanId) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(scanId) && existing().userId == request.auth.uid;
    }
  }
}
